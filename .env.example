# Contact form endpoint (optional). Create a free form at https://formspree.io,
# then copy this file to `.env` and paste your form endpoint below.
# Without it, the form falls back to opening the visitor's email client.
VITE_CONTACT_ENDPOINT=https://formspree.io/f/your-form-id

# Visitor statistics (optional). Sign up free at https://www.goatcounter.com,
# choose a code (e.g. shantchhetri), and put ONLY that code here.
# Dashboard: https://<code>.goatcounter.com  (visitors, countries, referrers, CV downloads)
VITE_GOATCOUNTER_CODE=
